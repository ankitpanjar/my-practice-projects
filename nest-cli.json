{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps",
  "sourceRoot": "apps/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/tsconfig.app.json",
    "plugins": [{ "name": "@nestjs/swagger", "options": { "introspectComments": true } }]
  },
  "projects": {
    "apps": {
      "type": "application",
      "root": "apps",
      "entryFile": "main",
      "sourceRoot": "apps/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tsconfig.app.json",
        "plugins": [{ "name": "@nestjs/swagger", "options": { "introspectComments": true } }]
      }
    },
    "libs": {
      "type": "library",
      "root": "libs",
      "entryFile": "index",
      "sourceRoot": "libs/src",
      "compilerOptions": { "tsConfigPath": "libs/tsconfig.lib.json" }
    }
  }
}
